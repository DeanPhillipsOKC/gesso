# Frozen files must stay byte for byte as frozen on every machine (#165). Images are binary; JSON is LF in the repo
# and in every checkout (the *.json line below wins over -text for JSON). The bench still reads frozen JSON with
# CRLF folded to LF, in case a checkout converts it anyway.
pictures/** -text
baseline/** -text
scores/** -text
*.png binary
*.jpg binary
# Code and the brief: LF in the repo and in every checkout.
*.py text eol=lf
*.js text eol=lf
*.md text eol=lf
*.json text eol=lf
